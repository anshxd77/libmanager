# Firebase Configuration
# Place your service account JSON file in the project root or specify the path below:
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Application Server Configuration
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Institutional Circulation Policies
DEFAULT_LOAN_DAYS=14
FACULTY_LOAN_DAYS=30
RESEARCHER_LOAN_DAYS=60
DAILY_FINE_RATE=0.50
GRACE_PERIOD_DAYS=2
MAX_RENEWALS=2

# Gmail SMTP Configuration for OTP Delivery
# Use your Gmail address and a 16-character Google App Password (from myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Athena Library System
SMTP_ENABLED=True
SECRET_KEY=athena-institutional-library-secure-key-2026
OTP_EXPIRY_MINUTES=10
SUPER_ADMIN_APPROVAL_EMAIL=admin@athena.edu
